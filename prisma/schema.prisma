generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user{
  id  String @id @default(cuid())
  name String?
  email String @unique
  emailVerfied DateTime?
  image String?
  password String?

  userNetflix UserNetflix[]

  createAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNetflix{
  id  String @id @default(cuid())
  profileName String?
  avatarUrl String

  userId String
  user user @relation(fields: [userId], references:[id], onDelete: Cascade)

  createAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie{
  id String @id @default(cuid())
  title String @unique
  thumbnailUrl String
  genre String[]
  duration String
  age String
  trailerVideo String
  movieVideo String

  created DateTime @default(now())
}

model PopularMovie{
  id String @id @default(cuid())
  title String @unique
  thumbnailUrl String
  genre String[]
  duration String
  age String
  trailerVideo String
  movieVideo String

  ranking Int
}
